{
  "general":
    {
        "cycles": 20,
        "burn_in": 1,
        "experimentalist_num_samples": 4,
        "save_path": "results/pilot"
    },
  "experiment_runner":
  {
    "type": "affective_stroop_firebase",
    "kwargs":
