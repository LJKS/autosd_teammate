{
  "general":
    {
        "cycles": 100,
        "burn_in": 30,
        "experimentalist_num_samples": 15,
        "load_data": "experiment_data.csv",
        "save_path": "results_presentation/experiment"
    },
  "experiment_runner":
  {
    "type": "affective_stroop_firebase",
    "kwargs":
    {
      "firebase_credentials_path": "firebase_credentials.json",
      "preprocessing":"phase_summary",
      "length_range": [5, 40]
    }
  },
  "theorist":
  {
    "model": "basic_bms",
    "model_kwargs":
    {
      "epochs": 150
    },
    "preprocessing_function": "basic_affective_stroop_theorist_preprocessing"
  },
  "save": {
    "type": "affective_stroop_phase_summary_visualization_and_serialization",
    "save_every": 1,
    "save_path": "results_presentation/experiment"
  }
}